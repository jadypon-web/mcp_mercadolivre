{
  "manifest_version": "0.2",
  "name": "upseller-planilha",
  "display_name": "UpSeller - Planilha de Cadastro (JadyponHidro)",
  "version": "0.4.1",
  "description": "Monta a planilha de importação de produtos do UpSeller (para quem não tem a API) a partir dos dados pesquisados pelo Claude.",
  "author": { "name": "JadyponHidro" },
  "repository": { "type": "git", "url": "https://github.com/jadypon-web/mcp_mercadolivre" },
  "license": "MIT",
  "server": {
    "type": "node",
    "entry_point": "server/index.mjs",
    "mcp_config": { "command": "node", "args": ["${__dirname}/server/index.mjs"] }
  },
  "compatibility": { "platforms": ["win32", "darwin", "linux"], "runtimes": { "node": ">=18.0.0" } }
}
